# Credential-free demo mode is the release default. Never put secrets in NEXT_PUBLIC_*.
MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=
ENABLE_WEB_SEARCH=false
ENABLE_REALTIME_VOICE=false
OPENAI_REALTIME_MODEL=

# Optional cloud capability. Keep disabled until the full configuration and gates pass.
ENABLE_CLOUD=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only security material.
ANONYMOUS_SESSION_SECRET=
AGENT_STATE_ENCRYPTION_KEY=

# Deployment controls.
ENABLE_HSTS=false
ENABLE_HSTS_PRELOAD=false
NEXT_PUBLIC_BUILD_SHA=local
