{
  "name": "circloora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "eval:agent": "vitest run tests/agent-eval",
    "eval:safety": "vitest run tests/safety-eval",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@openai/agents": "0.13.5",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "latest",
    "clsx": "latest",
    "idb": "latest",
    "next": "16.2.10",
    "openai": "6.48.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "latest",
    "fake-indexeddb": "latest",
    "fast-check": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "sharp": "latest",
    "tailwindcss": "4.3.3",
    "typescript": "latest",
    "vitest": "latest"
  }
}
